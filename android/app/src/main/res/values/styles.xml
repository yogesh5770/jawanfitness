<?xml version="1.0" encoding="utf-8"?>
<!--
    JAWAN FITNESS - Android Themes
    ================================
    AppTheme                 — base app theme (applied to <application>)
    AppTheme.NoActionBar     — runtime theme after splash (no action bar, edge-to-edge)
    AppTheme.NoActionBarLaunch — launch / splash screen theme (uses SplashScreen API)
-->
<resources>

    <!-- ─── Base App Theme ────────────────────────────────────────────────
         Parent: DayNight.NoActionBar so Android handles dark/light system switch.
         The actual UI colours are all driven by the Capacitor WebView, but these
         defaults ensure the native chrome (status bar, nav bar) matches the app.
    ──────────────────────────────────────────────────────────────────────── -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#f59e0b</item>
        <item name="colorPrimaryDark">#07090e</item>
        <item name="colorAccent">#f59e0b</item>

        <!-- No window title / action bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Full edge-to-edge: the WebView draws into system bar areas.
             CSS env(safe-area-inset-*) handles the inset offsets. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#07090e</item>
        <item name="android:navigationBarColor">#07090e</item>
        <!-- White icons on dark bars -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Smooth animation between activities -->
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- ─── Runtime Theme (after splash dismissed) ───────────────────────
         Identical to AppTheme but also sets fitsSystemWindows=false so the
         WebView content extends under the status / nav bar (true edge-to-edge).
    ──────────────────────────────────────────────────────────────────────── -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="android:windowBackground">#07090e</item>
        <!-- fitsSystemWindows=false → content draws behind system bars -->
        <item name="android:fitsSystemWindows">false</item>
        <!-- Hardware-accelerated compositing for smooth 60fps WebView -->
        <item name="android:hardwareAccelerated">true</item>
    </style>

    <!-- ─── Launch / Splash Screen Theme ─────────────────────────────────
         Uses AndroidX Core SplashScreen API (works on API 23+, fully branded on 31+).
         The @drawable/splash image is the branded logo PNG on the dark background.
    ──────────────────────────────────────────────────────────────────────── -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Splash background colour (obsidian black) -->
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">#07090e</item>
        <item name="android:navigationBarColor">#07090e</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- SplashScreen API: icon shown at centre of splash on Android 12+ -->
        <item name="windowSplashScreenBackground">#07090e</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Duration the splash stays visible (milliseconds, max 1000ms enforced by OS) -->
        <item name="windowSplashScreenAnimationDuration">800</item>
        <!-- Colour of the brand icon container (circle) on Android 12+ -->
        <item name="windowSplashScreenIconBackgroundColor">#07090e</item>
        <!-- Theme to switch to once the splash is done -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
